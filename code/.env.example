# YouTube Data API v3 키
YOUTUBE_API_KEY=

# Hugging Face 접근 토큰. 공개 Gemma 모델 또는 gated 모델 접근 시에만 필요합니다.
HF_TOKEN=

# 기본 모델 식별자 또는 로컬 모델 경로
MODEL_ID=google/gemma-3n-E2B-it
GEMMA_MODEL_PATH=

# 비공개 LoRA adapter 경로. repository에 넣지 않습니다.
LORA_ADAPTER_PATH=

# 실제 출석 이미지 URL을 조합해야 하는 사설 환경에서만 사용합니다.
ATTENDANCE_IMAGE_BASE_URL=
